{
  "name": "nutritrack",
  "private": true,
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "check": "turbo run lint typecheck test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "db:types": "supabase gen types typescript --local --schema public > packages/types/src/database.ts && prettier --write packages/types/src/database.ts",
    "env:local": "node scripts/write-local-env.mjs"
  },
  "devDependencies": {
    "prettier": "^3.9.10",
    "supabase": "^3.1.0",
    "turbo": "^2.11.10",
    "typescript": "catalog:"
  }
}
