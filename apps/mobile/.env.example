# Copy to .env. Values for local development come from `pnpm exec supabase status`.
# Only public values belong here — never the service-role key.
#
# On a physical phone, 127.0.0.1 points at the phone itself: use your computer's LAN IP instead
# (e.g. http://192.168.1.20:54321). On the Android emulator use http://10.0.2.2:54321.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
