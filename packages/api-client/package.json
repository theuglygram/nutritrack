{
  "name": "@nutritrack/api-client",
  "version": "0.0.0",
  "private": true,
  "description": "Typed data access over Supabase, shared by web and mobile. Apps create the Supabase client (platform-specific session storage) and pass it in.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --dir src",
    "test:integration": "node ../../scripts/integration-env.mjs vitest run --dir test"
  },
  "dependencies": {
    "@nutritrack/core": "workspace:*",
    "@nutritrack/schemas": "workspace:*",
    "@nutritrack/types": "workspace:*",
    "@supabase/supabase-js": "^2.119.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@nutritrack/config": "workspace:*",
    "@types/node": "^24.19.2",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "vitest": "^5.1.0"
  }
}
